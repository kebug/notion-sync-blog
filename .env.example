# Notion Sync Blog 环境变量配置

# 应用配置
APP_ENV=development
CONFIG_PATH=config.yaml

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=notion_sync_blog

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 文件存储路径
STORAGE_BASE_PATH=./content

# Notion Webhook Secret
NOTION_WEBHOOK_SECRET=your-webhook-secret-here

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
